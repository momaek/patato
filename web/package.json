{
  "name": "patato-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.yaml -o packages/api/src/schema.d.ts",
    "dev:admin": "pnpm --filter @patato/admin dev",
    "dev:portal": "pnpm --filter @patato/portal dev",
    "build": "pnpm -r --filter ./admin --filter ./portal build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vue-tsc": "2.1.10"
  }
}
